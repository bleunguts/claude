# --- Database ---
# Matches the postgres service in welltrack/docker-compose.yml.
DATABASE_URL="postgresql://welltrack:welltrack_dev_password@localhost:5432/welltrack?schema=public"

# --- Server ---
PORT=3000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# --- JWT ---
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Email / SMTP (optional in dev; unset = dev console transport, added in 1.3) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
