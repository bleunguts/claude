// Prisma schema for the WellTrack server.
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now()) @map("created_at")

  symptoms            Symptom[]
  symptomLogs         SymptomLog[]
  moodLogs            MoodLog[]
  medications         Medication[]
  medicationLogs      MedicationLog[]
  habits              Habit[]
  habitLogs           HabitLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId], map: "refresh_tokens_user_id_idx")
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Symptoms
// ---------------------------------------------------------------------------

model Symptom {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String? @map("user_id") @db.Uuid
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  category String
  isActive Boolean @default(true) @map("is_active")

  logs SymptomLog[]

  @@unique([userId, name], map: "symptoms_user_id_name_key")
  @@index([userId, isActive], map: "symptoms_user_id_is_active_idx")
  @@map("symptoms")
}

model SymptomLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symptomId String   @map("symptom_id") @db.Uuid
  symptom   Symptom  @relation(fields: [symptomId], references: [id], onDelete: Restrict)
  severity  Int
  notes     String?
  loggedAt  DateTime @map("logged_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, loggedAt], map: "symptom_logs_user_id_logged_at_idx")
  @@map("symptom_logs")
}

// ---------------------------------------------------------------------------
// Moods
// ---------------------------------------------------------------------------

model MoodLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moodScore   Int      @map("mood_score")
  energyLevel Int?     @map("energy_level")
  stressLevel Int?     @map("stress_level")
  notes       String?
  loggedAt    DateTime @map("logged_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, loggedAt], map: "mood_logs_user_id_logged_at_idx")
  @@map("mood_logs")
}

// ---------------------------------------------------------------------------
// Medications
// ---------------------------------------------------------------------------

model Medication {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  dosage    String?
  frequency String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  logs MedicationLog[]

  @@index([userId, isActive], map: "medications_user_id_is_active_idx")
  @@map("medications")
}

model MedicationLog {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicationId String     @map("medication_id") @db.Uuid
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  taken        Boolean
  takenAt      DateTime?  @map("taken_at")
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([userId, createdAt], map: "medication_logs_user_id_created_at_idx")
  @@map("medication_logs")
}

// ---------------------------------------------------------------------------
// Habits
// ---------------------------------------------------------------------------

enum TrackingType {
  boolean
  numeric
  duration

  @@map("tracking_type")
}

model Habit {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?      @map("user_id") @db.Uuid
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  trackingType TrackingType @map("tracking_type")
  unit         String?
  isActive     Boolean      @default(true) @map("is_active")

  logs HabitLog[]

  @@unique([userId, name], map: "habits_user_id_name_key")
  @@index([userId, isActive], map: "habits_user_id_is_active_idx")
  @@map("habits")
}

model HabitLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId       String   @map("habit_id") @db.Uuid
  habit         Habit    @relation(fields: [habitId], references: [id], onDelete: Restrict)
  valueBoolean  Boolean? @map("value_boolean")
  valueNumeric  Float?   @map("value_numeric")
  valueDuration Int?     @map("value_duration")
  notes         String?
  loggedAt      DateTime @map("logged_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId, loggedAt], map: "habit_logs_user_id_logged_at_idx")
  @@map("habit_logs")
}
